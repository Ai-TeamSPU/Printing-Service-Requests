# Public OAuth configuration
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
ALLOWED_GOOGLE_DOMAIN=spu.ac.th

# Browser origins allowed to send credentialed requests (comma-separated)
# Use exact HTTPS origins in production; never use * with cookies.
ALLOWED_ORIGINS=https://printing.example.spu.ac.th

# Private session configuration (generate at least 32 random bytes)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Private Apps Script connection. None of these values may be exposed to index.html.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
APPS_SCRIPT_CONNECT_TOKEN=replace-with-a-new-connect-token
APPS_SCRIPT_GATEWAY_TOKEN=replace-with-a-different-long-random-token
# SPREADSHEET_ID and FOLDER_ID are Script Properties in Apps Script, not browser/gateway inputs.

# false preserves the old policy: any verified account in the Workspace domain may enter.
# true additionally requires a matching email row in Personnel_Information.
REQUIRE_PERSONNEL=false

PORT=8080
NODE_ENV=production
